# Install on the app VM after replacing BOTH placeholders below.
# Read the four PM2 output/error logs and send them to a private collector.
# Only use an address reachable over your private Azure network; plain TCP
# syslog is not encrypted, so do not send this to a public internet address.
module(load="imfile")
input(type="imfile" File="/home/REPLACE_VM_USER/.pm2/logs/linklocker-1-out.log" Tag="linklocker-1:" Facility="local0")
input(type="imfile" File="/home/REPLACE_VM_USER/.pm2/logs/linklocker-1-error.log" Tag="linklocker-1-error:" Facility="local0" Severity="error")
input(type="imfile" File="/home/REPLACE_VM_USER/.pm2/logs/linklocker-2-out.log" Tag="linklocker-2:" Facility="local0")
input(type="imfile" File="/home/REPLACE_VM_USER/.pm2/logs/linklocker-2-error.log" Tag="linklocker-2-error:" Facility="local0" Severity="error")

if ($programname startswith "linklocker-") then {
    action(type="omfwd" target="REPLACE_COLLECTOR_PRIVATE_IP" port="514"
           protocol="tcp" action.resumeRetryCount="-1"
           queue.type="linkedList" queue.filename="linklocker-forward"
           queue.saveOnShutdown="on")
    stop
}
