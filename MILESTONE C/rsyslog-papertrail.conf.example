# use the system certificates to check papertrail's tls connection.
global(DefaultNetstreamDriverCAFile="/etc/ssl/certs/ca-certificates.crt")
module(load="imfile")

# read output and errors from each pm2 worker.
input(type="imfile" File="/home/azureuser/.pm2/logs/linklocker-1-out.log" Tag="linklocker-1:" Facility="local0" PersistStateInterval="100")
input(type="imfile" File="/home/azureuser/.pm2/logs/linklocker-1-error.log" Tag="linklocker-1-error:" Facility="local0" Severity="error" PersistStateInterval="100")
input(type="imfile" File="/home/azureuser/.pm2/logs/linklocker-2-out.log" Tag="linklocker-2:" Facility="local0" PersistStateInterval="100")
input(type="imfile" File="/home/azureuser/.pm2/logs/linklocker-2-error.log" Tag="linklocker-2-error:" Facility="local0" Severity="error" PersistStateInterval="100")

# replace the token placeholder on the vm; keep the real token off github.
template(name="LinkLockerSWOFormat" type="string"
  string="<%pri%>1 %timestamp:::date-rfc3339% %HOSTNAME% %programname% - - [solarwinds@41058 token=\"REPLACE_WITH_NEW_INGESTION_TOKEN\"] %msg%")

# send only linklocker logs to papertrail and retry if the connection drops.
if ($programname startswith "linklocker-") then {
    action(type="omfwd"
           target="syslog.collector.na-01.cloud.solarwinds.com"
           port="6514"
           protocol="tcp"
           TCP_Framing="octet-counted"
           template="LinkLockerSWOFormat"
           StreamDriver="gtls"
           StreamDriverMode="1"
           StreamDriverAuthMode="x509/name"
           StreamDriverPermittedPeers="*.collector.na-01.cloud.solarwinds.com"
           action.resumeRetryCount="-1"
           queue.type="linkedList"
           queue.filename="linklocker-papertrail"
           queue.saveOnShutdown="on")
    stop
}
